# Copy this file to `.env` and adjust for your machine:
#   cp apps/ai-service/.env.example apps/ai-service/.env
# `.env` is gitignored — never commit a real key.

# OpenRouter key (https://openrouter.ai/keys). Required only for live calls:
# the service boots and passes /health without it, and every test is mocked.
LLM_API_KEY=

# OpenRouter model slug. No default on purpose — catalogue slugs change.
# Cheap, JSON-capable options (check https://openrouter.ai/models):
#   openai/gpt-5-mini
#   google/gemini-2.5-flash
#   deepseek/deepseek-chat-v3.1
LLM_MODEL=

# OpenAI-compatible gateway; overridable for another provider later.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Per-call timeout, transport retries, and output cap.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2000

# core-api, the only data source this service has (D60).
CORE_API_URL=http://127.0.0.1:3001
CORE_API_TIMEOUT_SECONDS=30

# Must be the SAME value as INTERNAL_API_TOKEN in apps/core-api/.env.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=
