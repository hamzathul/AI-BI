# Copy this file to `.env` and adjust for your machine:
#   cp apps/core-api/.env.example apps/core-api/.env
# `.env` is gitignored — never commit real credentials.

# development | test | production
NODE_ENV=development

# HTTP port for core-api
PORT=3001

# Exact browser origin allowed by CORS (Phase 3 web app). No trailing slash.
WEB_ORIGIN=http://localhost:3000

# App's own Postgres 18 (docker-compose.yml, host port 5433 — see D25).
# This is where AI BI stores its own data (Prisma, from step 2.1b).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aibi

# Acme sample *source* database, read-only (D30/D33). Loaded with `pnpm db:seed`
# — see sample-data/README.md. The app reads it as acme_reader; never writes.
SOURCE_DATABASE_URL=postgresql://acme_reader:acme_reader_dev@localhost:5433/acme

# Shared secret for server-to-server calls from ai-service (D60).
# Generate one and use the SAME value in apps/ai-service/.env:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=

# Where ai-service listens (6.4). core-api proxies POST /api/chat here, adding
# the same token above. The ai-service port stays server-side.
AI_SERVICE_URL=http://127.0.0.1:8000
# Whole-run budget for one chat answer (ms). LLM calls are slow by nature.
AI_SERVICE_TIMEOUT_MS=120000
