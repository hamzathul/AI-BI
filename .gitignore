# Ignored on purpose: secrets, generated output, personal files.

# Dependencies — reinstalled from package.json + pnpm-lock.yaml (the lockfile IS committed)
node_modules/

# Build output — regenerated from source
dist/
build/
.next/
out/
*.tsbuildinfo

# Prisma generated client — regenerated by `prisma generate` (postinstall)
apps/core-api/src/generated/

# OpenAPI snapshot — intermediate for `pnpm --filter web api:types`
apps/core-api/openapi.json

# Playwright artifacts
playwright-report/
test-results/
blob-report/

# Test coverage reports
coverage/

# Python — ai-service (uv). The lockfile and .python-version ARE committed.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Secrets — NEVER committed; only the .env.example template is
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / IDE — personal files stay personal
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# OS clutter (Windows + macOS)
Thumbs.db
Desktop.ini
.DS_Store
