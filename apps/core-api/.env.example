# Copy this file to `.env` and adjust for your machine:
#   cp apps/core-api/.env.example apps/core-api/.env
# `.env` is gitignored — never commit real credentials.

# development | test | production
NODE_ENV=development

# HTTP port for core-api
PORT=3001

# App's own Postgres 18 (docker-compose.yml, host port 5433 — see D25).
# The read-only source database (SOURCE_DATABASE_URL) arrives in step 2.1a.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aibi
